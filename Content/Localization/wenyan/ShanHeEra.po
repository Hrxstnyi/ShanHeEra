msgstr "史非背景也。"

msgid "Philosophy_2"
msgstr "史即世界也。"

msgid "Philosophy_3"
msgstr "天下不待英雄出。"

msgid "Philosophy_4"
msgstr "兆民之擇，共成其世。"

msgid "Philosophy_5"
msgstr "玩者非天選之人。"

msgid "Philosophy_6"
msgstr "玩者不過生於華夏之一命耳。"

