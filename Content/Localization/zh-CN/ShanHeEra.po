# === Core Philosophy ===
msgid "Philosophy_1"
msgstr "历史不是背景。"

msgid "Philosophy_2"
msgstr "历史就是世界本身。"

msgid "Philosophy_3"
msgstr "天下不会等待一个英雄出现。"

msgid "Philosophy_4"
msgstr "亿万普通人的选择，共同组成时代。"

msgid "Philosophy_5"
msgstr "玩家不是被选中的人。"

msgid "Philosophy_6"
msgstr "玩家只是出生在华夏大地上的一个生命。"

