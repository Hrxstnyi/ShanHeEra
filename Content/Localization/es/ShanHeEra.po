msgid "Philosophy_1"
msgstr "La historia no es un fondo."

msgid "Philosophy_2"
msgstr "La historia es el mundo mismo."

msgid "Philosophy_3"
msgstr "El mundo no espera a un héroe."

msgid "Philosophy_4"
msgstr "Las elecciones de millones de personas comunes forman la época."

msgid "Philosophy_5"
msgstr "El jugador no es el elegido."

msgid "Philosophy_6"
msgstr "El jugador es solo un ser nacido en la tierra de China."

